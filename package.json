{
  "name": "gestione-website-builder",
  "version": "1.0.0",
  "private": true,
  "description": "Gestione Semplificata — Website Builder (runtime satellite). Identità e fatturazione restano su Gestione Semplificata.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "node --test src/modules/website-builder/__tests__/*.test.js",
    "build:ui": "npm --prefix website-builder-ui install && npm --prefix website-builder-ui run build",
    "postinstall": "npm --prefix website-builder-ui install --omit=dev || true"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-rate-limit": "^7.4.1",
    "express-session": "^1.19.0",
    "helmet": "^7.2.0",
    "multer": "^2.3.0"
  },
  "devDependencies": {
    "supertest": "^7.2.2"
  }
}
