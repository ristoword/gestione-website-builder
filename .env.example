PORT=3000
NODE_ENV=development
WEBSITE_BUILDER_ENABLED=true
WEBSITE_BUILDER_APP_URL=https://gestione-website-builder-production.up.railway.app
WEBSITE_BUILDER_SQLITE_PATH=
WEBSITE_BUILDER_TEMPLATES_DIR=
SESSION_SECRET=cambia-questa-stringa-lunga
GESTIONE_SEMPLIFICATA_BASE_URL=https://gestionesemplificata.com

# Solo sviluppo locale (non è un secondo account in produzione)
WEBSITE_BUILDER_DEV_TENANT_ID=usr_dev_locale
WEBSITE_BUILDER_DEV_EMAIL=dev@local.test
WEBSITE_BUILDER_DEV_PRODUCTS=sitoweb_pro

# AI: chiave reale oppure modalità offline per i test
# OPENAI_API_KEY=
WEBSITE_AI_OFFLINE=true

# Verifica DNS TXT: stub in locale
WEBSITE_BUILDER_DNS_STUB=true
